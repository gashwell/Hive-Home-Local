{
  "entity": {
    "binary_sensor": {
      "heat_boost": { "default": "mdi:rocket-launch" },
      "water_boost": { "default": "mdi:rocket-launch" }
    },
    "button": {
      "boost_heating":    { "default": "mdi:radiator" },
      "boost_water":      { "default": "mdi:water-boiler" },
      "run_adaptation":   { "default": "mdi:cog-refresh" },
      "enter_mounting":   { "default": "mdi:wrench" }
    },
    "number": {
      "heating_boost_duration":    { "default": "mdi:timer" },
      "heating_boost_temperature": { "default": "mdi:thermometer" },
      "heating_frost_prevention":  { "default": "mdi:snowflake-thermometer" },
      "water_boost_duration":      { "default": "mdi:timer" },
      "boost_temperature":         { "default": "mdi:thermometer" },
      "boost_duration":            { "default": "mdi:timer" },
      "setpoint_offset":           { "default": "mdi:thermometer-lines" }
    },
    "select": {
      "system_mode_water": { "default": "mdi:water-boiler" },
      "keypad_lock":       { "default": "mdi:lock" }
    },
    "sensor": {
      "boost_remaining_heat":    { "default": "mdi:timer-outline" },
      "boost_remaining_water":   { "default": "mdi:timer-outline" },
      "local_temperature_heat":  { "default": "mdi:thermometer" },
      "battery":                 { "default": "mdi:battery" },
      "heating_demand":          { "default": "mdi:radiator-off",
                                   "state": { "heat": "mdi:radiator", "idle": "mdi:radiator-off" } },
      "running_state_heat": {
        "default": "mdi:radiator-disabled",
        "state": {
          "heat":        "mdi:radiator",
          "idle":        "mdi:radiator-off",
          "off":         "mdi:radiator-off",
          "preheating":  "mdi:radiator"
        }
      },
      "running_state_water": {
        "default": "mdi:water-boiler-off",
        "state": {
          "heat": "mdi:water-boiler",
          "idle": "mdi:water-boiler-off",
          "off":  "mdi:water-boiler-off"
        }
      }
    }
  },
  "services": {
    "boost_heating":         { "service": "mdi:rocket-launch" },
    "boost_water":           { "service": "mdi:rocket-launch" },
    "cancel_boost_heating":  { "service": "mdi:cancel" },
    "cancel_boost_water":    { "service": "mdi:cancel" },
    "boost_trv":             { "service": "mdi:rocket-launch" },
    "end_boost_trv":         { "service": "mdi:cancel" },
    "set_trv_schedule":      { "service": "mdi:calendar-clock" },
    "clear_trv_schedule":    { "service": "mdi:calendar-remove" },
    "advance_trv_schedule":  { "service": "mdi:skip-next" },
    "set_holiday":           { "service": "mdi:beach" },
    "cancel_holiday":        { "service": "mdi:cancel" },
    "add_room":              { "service": "mdi:home-plus" },
    "remove_room":           { "service": "mdi:home-minus" }
  }
}
